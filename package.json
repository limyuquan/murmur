{
  "name": "murmur",
  "displayName": "Murmur",
  "description": "Live translated subtitles over any video, made on your own machine.",
  "version": "0.1.0",
  "author": "Lim Yu Quan",
  "license": "MIT",
  "private": true,
  "keywords": [
    "chrome-extension",
    "subtitles",
    "captions",
    "speech-recognition",
    "translation",
    "on-device",
    "webgpu"
  ],
  "homepage": "https://github.com/limyuquan/murmur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limyuquan/murmur.git"
  },
  "bugs": {
    "url": "https://github.com/limyuquan/murmur/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "icons": "node scripts/icons.mjs",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build:e2e && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "dashjs": "5.3.0",
    "hls.js": "1.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shaka-player": "5.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@litert-lm/core": "0.19.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
